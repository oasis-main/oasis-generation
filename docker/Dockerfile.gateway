# oasis-generation gateway — CPU-only, stays slim (target < 300 MB).
# Weights are NEVER baked into images (oasis-voice VOICE-001 lesson).
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

EXPOSE 8800
CMD ["uvicorn", "oasis_generation.main:app", "--host", "0.0.0.0", "--port", "8800"]
