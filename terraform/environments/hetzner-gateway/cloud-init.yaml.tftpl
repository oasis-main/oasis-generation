#cloud-config
# Gateway VM bootstrap. NO secrets here. Only 443 is exposed (firewall); the
# gateway container is reachable only on the internal compose network.
package_update: true
packages:
  - docker.io
  - docker-compose-v2
write_files:
  - path: /opt/gateway/Caddyfile
    permissions: "0644"
    content: |
      {
        email ${acme_email}
      }
      ${gateway_hostname} {
        tls {
          issuer acme {
            disable_http_challenge
          }
        }
        reverse_proxy gateway:8800
      }
  - path: /opt/gateway/docker-compose.yml
    permissions: "0644"
    content: |
      services:
        gateway:
          image: ${gateway_image}
          restart: unless-stopped
          expose: ["8800"]
          environment:
            # Fail closed: with no service tokens the gateway refuses to start (503).
            OASIS_GENERATION_REQUIRE_AUTH: "1"
          # Written AFTER boot (never by Terraform): OASIS_GENERATION_SERVICE_TOKENS,
          # AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY. Compose refuses to start
          # the stack until this file exists.
          env_file:
            - path: /opt/gateway/secrets.env
              required: true
          volumes:
            - ./usage:/usage
        caddy:
          image: ${caddy_image}
          restart: unless-stopped
          depends_on: [gateway]
          ports:
            - "443:443"
          volumes:
            - ./Caddyfile:/etc/caddy/Caddyfile:ro
            - caddy_data:/data
      volumes:
        caddy_data: {}
runcmd:
  - systemctl enable --now docker
  # The gateway image runs as uid 10001 (non-root); the usage ledger is silently
  # empty unless this folder is writable by that uid.
  - install -d -o 10001 -g 10001 /opt/gateway/usage
  # Do NOT start the stack here: it cannot start without /opt/gateway/secrets.env.
  # The Mac-side bootstrap (claw-gen-vm-bootstrap) writes that file over SSH and
  # runs `docker compose up -d`.
