# oasis-generation gateway — CPU-only, stays slim (target < 300 MB).
# Weights are NEVER baked into images (oasis-voice VOICE-001 lesson).
#
# Reproducible on purpose (GEN-008, Mike 2026-10-19): the base image is pinned by
# digest (multi-arch index, so the Mac's arm64 build and the VM's amd64 build
# share one line), and every dependency is installed from a hashed lock file.
# Regenerate the lock after any pyproject.toml change:
#   uv pip compile pyproject.toml --python-version 3.12 \
#     --python-platform x86_64-manylinux_2_28 --generate-hashes --no-header \
#     -o docker/requirements-gateway.lock
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src

WORKDIR /app
COPY docker/requirements-gateway.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
 && rm /tmp/requirements.lock
# The package runs from source (PYTHONPATH): `pip install .` would fetch an
# unpinned build backend at build time.
COPY src ./src

# Non-root. Host folders mounted at /usage and /state must be writable by uid
# 10001 on a Linux host (Docker Desktop on macOS maps ownership itself).
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin gateway
USER 10001

EXPOSE 8800
CMD ["uvicorn", "oasis_generation.main:app", "--host", "0.0.0.0", "--port", "8800"]
