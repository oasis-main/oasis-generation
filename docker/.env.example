# oasis-generation gateway — environment template.
# Copy to docker/.env (gitignored) and fill in. Loaded via env_file by
# docker/docker-compose.yml. Secrets go here, NOT in the compose `environment:`.

# Comma-separated service tokens the gateway accepts (Bearer). Empty = auth off
# (local dev only — never deploy without tokens).
OASIS_GENERATION_SERVICE_TOKENS=

# ---- Bedrock backend (GEN-003 provider fanout) ------------------------------
# The gateway proxies Claude / GLM / DeepSeek / Llama / GPT-OSS / Nova to Amazon
# Bedrock so the bots never hold an AWS key. Use the SAME oasis-dev key that
# powers OpenCode + bounty_hunter (the oasis-dev billing account). Grab the
# values from the [oasis-dev] profile:
#   aws configure get aws_access_key_id     --profile oasis-dev
#   aws configure get aws_secret_access_key --profile oasis-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional: override the region the Bedrock backend targets (defaults us-east-1,
# where all the inference profiles we use live).
# OASIS_GENERATION_BEDROCK_REGION=us-east-1

# Optional: direct OpenAI-compatible providers (openai_compat catalog entries,
# e.g. real GPT-5). Only needed if you enable those entries in catalog.py.
# OPENAI_API_KEY=
